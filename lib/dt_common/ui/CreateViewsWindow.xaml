<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Views by Category"
        Height="620" Width="560"
        MinHeight="480" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#00B8D9"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#00A6C4"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#101820"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1F26"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#E2E5EA"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F7F9FC"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#C7CCD1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Padding" Value="6,0,0,0"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="28,22">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="AUTOIFC" Foreground="{StaticResource AccentBrush}"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="  ·  by Jayson Allosada" Foreground="#7A8796"
                               FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Create Views by Category" Foreground="White"
                           FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Generate an isolated 3D view for each selected category"
                           Foreground="#A9B4BE" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="28,20,28,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="txtSearch" Grid.Row="0" Height="32" Padding="8,6"
                     BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                     VerticalContentAlignment="Center" FontSize="13"/>

            <TextBlock x:Name="lblCategoryHeader" Grid.Row="1" Margin="2,14,0,6"
                       Text="Categories" FontWeight="SemiBold" FontSize="13"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                    CornerRadius="4" Background="{StaticResource PanelBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <StackPanel x:Name="categoryPanel"/>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnCheckAll" Grid.Column="0" Content="Check All" Style="{StaticResource LinkButton}"/>
                <Button x:Name="btnUncheckAll" Grid.Column="1" Content="Uncheck All" Style="{StaticResource LinkButton}" Margin="4,0,0,0"/>
                <TextBlock x:Name="lblSelectedCount" Grid.Column="3" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnCancel" Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button x:Name="btnConfirm" Grid.Column="2" Content="Create Views" Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
