<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export IFC by Category"
        Height="760" Width="600"
        MinHeight="620" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#6FCF97"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#56BE82"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#16261D"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C2620"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F7568"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#D7EAE0"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#EFFBF4"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#C7CCD1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Padding" Value="6,0,0,0"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="2,20,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="28,22">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="AUTOIFC" Foreground="{StaticResource AccentBrush}"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="  ·  by Jayson Allosada" Foreground="#7C9186"
                               FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Export IFC by Category" Foreground="White"
                           FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Batch-export generated category views to individual IFC files"
                           Foreground="#AEC2B4" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="28,20,28,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- search -->
                <RowDefinition Height="Auto"/>
                <!-- categories label -->
                <RowDefinition Height="*"/>
                <!-- category list, fills available space -->
                <RowDefinition Height="Auto"/>
                <!-- check all row -->
                <RowDefinition Height="Auto"/>
                <!-- setup label -->
                <RowDefinition Height="Auto"/>
                <!-- setup row -->
                <RowDefinition Height="Auto"/>
                <!-- folder label -->
                <RowDefinition Height="Auto"/>
                <!-- folder row -->
            </Grid.RowDefinitions>

            <TextBox x:Name="txtSearch" Grid.Row="0" Height="32" Padding="8,6"
                     BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                     VerticalContentAlignment="Center" FontSize="13"/>

            <TextBlock x:Name="lblCategoryHeader" Grid.Row="1" Margin="2,14,0,6"
                       Text="Categories" FontWeight="SemiBold" FontSize="13"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                    CornerRadius="4" Background="{StaticResource PanelBrush}" MinHeight="140">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <StackPanel x:Name="categoryPanel"/>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnCheckAll" Grid.Column="0" Content="Check All" Style="{StaticResource LinkButton}"/>
                <Button x:Name="btnUncheckAll" Grid.Column="1" Content="Uncheck All" Style="{StaticResource LinkButton}" Margin="4,0,0,0"/>
                <TextBlock x:Name="lblSelectedCount" Grid.Column="3" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
            </Grid>

            <TextBlock Grid.Row="4" Text="IFC Export Setup" Style="{StaticResource FieldLabel}"/>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,10,0">
                    <TextBlock x:Name="lblCurrentSetup" Text="No setup configured yet" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="btnConfigureSetup" Grid.Column="1" Content="Configure Settings..." Style="{StaticResource SecondaryButton}"/>
            </Grid>

            <TextBlock Grid.Row="6" Text="Output Folder" Style="{StaticResource FieldLabel}"/>

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtOutputFolder" Grid.Column="0" Height="34" Padding="8,6"
                         BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                         VerticalContentAlignment="Center" FontSize="13" IsReadOnly="True"
                         Background="{StaticResource PanelBrush}" Margin="0,0,10,0"/>
                <Button x:Name="btnBrowseFolder" Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}"/>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnCancel" Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button x:Name="btnConfirm" Grid.Column="2" Content="Export Selected" Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
